{
  "name": "lajikartat.fi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "rm -rf .svelte-kit/cloudflare && wrangler types --check && vite build",
    "preview": "wrangler dev --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:apply:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "drizzle-kit migrate",
    "data:publish:local": "node scripts/publish-local.mjs",
    "pipeline": "pnpm --filter @lajikartat/pipeline"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "8.0.0-next.0",
    "@sveltejs/kit": "3.0.0-next.4",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  }
}
